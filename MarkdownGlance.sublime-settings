{
    // Delay after the latest edit before a render begins.
    "update_delay_ms": 100,

    // Mermaid is opt-in because diagram source is sent to mermaid_server.
    "enable_mermaid": false,
    "mermaid_server": "https://mermaid.ink",

    // HTTP images and HTTPS-to-HTTP redirects are blocked by default.
    "allow_insecure_remote_images": false,
    "remote_timeout_seconds": 15.0,
    "remote_max_bytes": 10485760,
    "remote_max_dimension": 4096,

    // A separate TOC is shown only when both thresholds are met.
    "toc_minimum_length": 1200,
    "toc_minimum_headings": 3,

    // Diagnostics still redact document text and Mermaid URLs when enabled.
    "debug_logging": false
}
